# ── WhatsOrder Oman — environment template ─────────────────────────────────
# Copy to `.env` for docker-compose. NEVER commit the real .env file.

# ── Database ───────────────────────────────────────────────────────────────
# Default is Postgres. For a zero-dependency local run (no Docker), start the
# API with Database__Provider=Sqlite instead — it uses a local file database.
# Database__Provider=Postgres

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=whatsorder
POSTGRES_USER=whatsorder
POSTGRES_PASSWORD=change-me-strong-password

# Connection string used by the API container (double underscore = nesting)
ConnectionStrings__Default=Host=db;Port=5432;Database=whatsorder;Username=whatsorder;Password=change-me-strong-password

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate a random 64+ char secret, e.g.:  openssl rand -base64 64
Jwt__Issuer=WhatsOrder
Jwt__Audience=WhatsOrder
Jwt__SigningKey=REPLACE_WITH_RANDOM_64_CHAR_SECRET________________________________
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# ── Meta WhatsApp Cloud API ────────────────────────────────────────────────
# From https://developers.facebook.com → your app → WhatsApp → API Setup.
# Leave Enabled=false to run the whole product without Meta credentials
# (notifications are recorded as "Skipped" instead of sent).
WhatsApp__Enabled=false
WhatsApp__ApiVersion=v20.0
WhatsApp__PhoneNumberId=
WhatsApp__BusinessAccountId=
WhatsApp__AccessToken=
WhatsApp__WebhookVerifyToken=choose-any-random-string-and-paste-it-in-meta
WhatsApp__AppSecret=
# Business-initiated messages outside the 24h window need approved templates:
WhatsApp__UseTemplates=false

# ── App ────────────────────────────────────────────────────────────────────
# Public URL of the storefront (used in password-reset links / share links)
App__PublicBaseUrl=http://localhost:4200
Cors__AllowedOrigins__0=http://localhost:4200

# Development conveniences (set false in production)
App__SeedDemoData=true
